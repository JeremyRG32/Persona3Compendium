<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Persona3Compendium.Web</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/styles.css"/>
</head>
<body class="flex flex-col min-h-screen">
    <header class="w-full fixed z-50">
        <nav class="p-4 bg-black text-white shadow-lg">
            <div class="flex flex-row items-center justify-between">

                <div class="flex flex-row items-center gap-4">
                    <a asp-controller="Home" asp-action="Index">
                        <img src="~/icons/P3-logo.svg" alt="Persona 3 Reload Logo" width="64" height="64"/>
                    </a>
                    <h1 class="text-2xl font-logo">Persona Compendium</h1>
                </div>

                <ul class="flex flex-row gap-6 text-lg font-ternary">
                    <li><a asp-area="" asp-controller="Arcana" asp-action="Index">Arcanas</a></li>
                    <li><a asp-area="" asp-controller="Persona" asp-action="Index">Personas</a></li>
                    <li><a asp-area="" asp-controller="Element" asp-action="Index">Elements</a></li>
                </ul>

            </div>
        </nav>
    </header>
        <main role="main" class="">
            @RenderBody()
        </main>

    <footer class="w-full fixed bottom-0">
        <div class="bg-black text-white text-center p-4 font-ternary">
            Persona Compendium © @DateTime.Now.Year  
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
