@model PersonaViewModel

@{
    ViewData["Title"] = "Personas";
    var stats = new[]{
        new {Name = "Strength", Value = Model.Persona.Strength},
        new {Name = "Magic", Value = Model.Persona.Magic},
        new {Name = "Agility", Value = Model.Persona.Agility},
        new {Name = "Endurance", Value = Model.Persona.Endurance},
        new {Name = "Luck", Value = Model.Persona.Luck}
    };
}

<div class="max-w-5xl mx-auto mt-40 flex gap-3 text-white">
    <div class="flex flex-col">

        <div class="bg-blue-900/40 p-3 rounded-lg mb-2">

            <div class="flex flex-row items-center justify-between">
                <h2 class="font-main text-4xl text-shadow-2xs text-shadow-blue-900">@Model.Persona.Name</h2>
                @if (Model.Persona.Dlc == 1)
                {
                    <h4 class="font-main text-amber-300 text-xl text-shadow-2xs text-shadow-blue-600">
                        DLC Req
                    </h4>
                }
            </div>

            <div class="flex flex-row items-center justify-between">
                <h3 class="font-main text-amber-300 text-xl text-shadow-2xs text-shadow-blue-600 ">Base Level:
                @Model.Persona.Level</h3>

                 <h4 class="font-main text-white text-lg text-center text-shadow-2xs text-shadow-blue-600">
                        @Model.Persona.Arcana.Name <br />Arcana
                </h4>
            </div>

            <div class="rounded-lg max-w-96">
                <img class="drop-shadow-2xl object-contain w-100 h-100" src="/icons/personas/@(Model.Persona.Name).png"
                    alt="Persona Image">
            </div>



        </div>

        <div class="bg-blue-900/40 backdrop-blur-2xl p-3 rounded-lg">
            <p class="text-center font-main">
                @Model.Persona.Description
            </p>
        </div>

    </div>

    <div class="bg-blue-900/40 backdrop-blur-md rounded-lg p-3 min-w-2xl flex flex-col text-center">

        <h3 class="font-main text-2xl mb-2 text-amber-300">Elemental Affinities</h3>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">

            <!-- WEAK -->
            @foreach (var element in Model.Persona.Weaknesses)
            {
                <div class="flex items-center gap-2 bg-blue-950/40 p-2 rounded-lg">
                    @if (element.Element.Name != "")
                    {
                        <img src="/icons/elements/@(element.Element.Name).png" height="90" width="90" />
                        <span class="font-main text-red-400">Weak</span>
                    }
                    else
                    {
                        <span class="font-main text-red-400">No Weaknesses</span>
                    }
                </div>
            }

            <!-- RESIST -->
            @foreach (var element in Model.Persona.Resists)
            {
                <div class="flex items-center gap-2 bg-blue-950/40 p-2 rounded-lg">
                    @if (element.Element.Name != "")
                    {
                        <img src="/icons/elements/@(element.Element.Name).png" height="90" width="90" />
                        <span class="font-main text-yellow-300">Resists</span>
                    }
                    else
                    {
                        <span class="font-main text-yellow-300">No Resistances</span>
                    }
                </div>
            }

            <!-- REFLECT -->
            @foreach (var element in Model.Persona.Reflects)
            {
                <div class="flex items-center gap-2 bg-blue-950/40 p-2 rounded-lg">
                    @if (element.Element.Name != "")
                    {
                        <img src="/icons/elements/@(element.Element.Name).png" height="90" width="90" />
                        <span class="font-main text-blue-300">Reflects</span>
                    }
                    else
                    {
                        <span class="font-main text-blue-300">No Reflects</span>
                    }
                </div>
            }

            <!-- ABSORB -->
            @foreach (var element in Model.Persona.Absorbs)
            {
                <div class="flex items-center gap-2 bg-blue-950/40 p-2 rounded-lg">
                    @if (element.Element.Name != "")
                    {
                        <img src="/icons/elements/@(element.Element.Name).png" height="90" width="90" />
                        <span class="font-main text-green-300">Absorbs</span>
                    }
                    else
                    {
                        <span class="font-main text-green-300">No Absorptions</span>
                    }
                </div>
            }

            <!-- NULLIFY -->
            @foreach (var element in Model.Persona.Nullifies)
            {
                <div class="flex items-center gap-2 bg-blue-950/40 p-2 rounded-lg">
                    @if (element.Element.Name != "")
                    {
                        <img src="/icons/elements/@(element.Element.Name).png" height="90" width="90" />
                        <span class="font-main text-gray-300">Null</span>
                    }
                    else
                    {
                        <span class="font-main text-gray-300">No Nulls</span>
                    }
                </div>
            }
        </div>

        <h3 class="font-main text-2xl mt-5 mb-4 text-amber-300">Base Stats</h3>


        @foreach (var element in stats)
        {
            <h4 class="text-white text-shadow-current shadow-cyan-400 font-main mb-2 text-2xl">@(element.Name)</h4>
            <div class="bg-gray-700 rounded-xl flex h-7 w-full">
                <div id="progress" style="--final-width: @((element.Value / 99.0) * 100)%;"
                    class="h-full rounded-xl justify-center progress-animation bg-cyan-300 shadow shadow-cyan-700">
                    <span class="font-main text-white text-shadow-2xs text-shadow-black">@element.Value</span>
                </div>
            </div>
        }
    </div>
</div>  